[Unit]
Description=Cubie passive robot perception and localization runtime
After=robotd.service
Requires=robotd.service

[Service]
Type=simple
User=radxa
Group=radxa
WorkingDirectory=/home/radxa/cubie-robot
Environment=LD_LIBRARY_PATH=/home/radxa/yolo26n-a733/src/model-zoo/common/npuruntime/lib_linux_aarch64/A733
ExecStart=/home/radxa/cubie-robot/bin/robot-runtime-a733 --config config/robot.yaml
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
